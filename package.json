{
  "name": "@geomanti/connector-kit",
  "version": "0.1.0",
  "description": "Reliability primitives for third-party API integrations: retry with jittered backoff, circuit breaker, token-bucket rate limiting, webhook signature verification, and Prometheus metrics.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": ["dist/src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test dist/test/*.test.js"
  },
  "keywords": [
    "integration", "reliability", "retry", "circuit-breaker",
    "rate-limit", "webhook", "prometheus", "typescript"
  ],
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Geomanti/connector-kit.git"
  }
}
